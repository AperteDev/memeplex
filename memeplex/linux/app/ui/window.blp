using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Memeplex";
  default-width: 1100;
  default-height: 750;

  // A sidebar that hides (F9), as Todav's.
  content: Adw.OverlaySplitView split {
    min-sidebar-width: 240;
    max-sidebar-width: 320;

    sidebar: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // As Todav's sidebar switcher.
        title-widget: Adw.InlineViewSwitcher {
          stack: sidebar_views;
        };

        [start]
        Gtk.Button {
          icon-name: "folder-open-symbolic";
          tooltip-text: _("Open Folder… (Ctrl+O)");
          action-name: "win.open";
        }

        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: main_menu;
          tooltip-text: _("Main Menu");
          primary: true;
        }
      }

      content: Adw.ViewStack sidebar_views {
        // All, Untagged, then the tags (src/window.rs `refresh_tags`).
        Adw.ViewStackPage {
          name: "tags";
          title: _("Tags");

          child: Gtk.ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            Gtk.ListBox tag_list {
              styles ["navigation-sidebar"]
            }
          };
        }

        // The meme folder and the folders in it, as Notav's tree (src/window.rs
        // `refresh_tree`).
        Adw.ViewStackPage {
          name: "folders";
          title: _("Folders");

          child: Gtk.ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            Gtk.ListBox tree {
              styles ["navigation-sidebar"]
            }
          };
        }
      };
    };

    // The memes of the folder picked in the tree (src/window.rs `show_folder`).
    content: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle title {
          title: "Memeplex";
        };

        [start]
        Gtk.ToggleButton {
          icon-name: "sidebar-show-symbolic";
          tooltip-text: _("Toggle Sidebar (F9)");
          active: bind split.show-sidebar bidirectional;
        }

        [end]
        Gtk.MenuButton {
          icon-name: "view-grid-symbolic";
          tooltip-text: _("View Options");

          // The builder sets the menu after the children: the size row is added to it in code
          // (`size_box`).
          popover: Gtk.PopoverMenu view_popover {
            menu-model: view_menu;

            [size]
            Gtk.Box size_box {
              spacing: 6;
              margin-start: 6;
              margin-end: 6;

              Gtk.Image {
                icon-name: "zoom-out-symbolic";
              }

              // A thumbnail's side in pixels (src/window.rs `connect_size`).
              Gtk.Scale size {
                hexpand: true;
                width-request: 180;
                draw-value: false;
                tooltip-text: _("Thumbnail Size");

                adjustment: Gtk.Adjustment {
                  lower: 80;
                  upper: 400;
                  value: 180;
                  step-increment: 20;
                  page-increment: 40;
                };

                accessibility {
                  label: _("Thumbnail Size");
                }
              }

              Gtk.Image {
                icon-name: "zoom-in-symbolic";
              }
            }
          };
        }
      }

      content: Gtk.Overlay {
        child: Gtk.Stack stack {
          Gtk.StackPage {
            name: "welcome";

            child: Adw.StatusPage {
              icon-name: "dev.aperte.Memeplex";
              title: "Memeplex";
              description: _("Open a folder with your memes to start");

              Gtk.Button {
                label: _("Open Folder…");
                action-name: "win.open";
                halign: center;
                styles ["suggested-action", "pill"]
              }
            };
          }

          Gtk.StackPage {
            name: "empty";

            // Its description is the group's (src/window.rs `show_group`).
            child: Adw.StatusPage empty {
              icon-name: "folder-pictures-symbolic";
              title: _("No Memes");
            };
          }

          Gtk.StackPage {
            name: "grid";

            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;

              Gtk.GridView grid {
                max-columns: 30;
                single-click-activate: true;
                styles ["memes"]
              }
            };
          }
        };

        // A meme over the whole panel, GIFs and videos playing. It grows out of its thumbnail
        // while the backdrop fades in over the grid, and back (src/window.rs `open_preview`,
        // `animate_preview`).
        [overlay]
        Gtk.Overlay preview {
          visible: false;

          Gtk.Box preview_backdrop {
            styles ["preview"]
          }

          // Its margins put it where the thumbnail is while it grows (`set_progress`).
          [overlay]
          Gtk.Stack preview_stack {
            // Pictures, GIFs (playing, muted) among them.
            Gtk.Picture preview_picture {
              content-fit: contain;
            }

            // Videos, with their controls.
            Gtk.Video preview_video {
              autoplay: true;
              loop: true;
            }
          }

          // The meme's tags, each removed by a click, and one more typed in (src/window.rs
          // `show_tags`), above the meme.
          [overlay]
          Gtk.Box preview_bar {
            halign: center;
            valign: start;
            margin-top: 12;
            spacing: 6;
            styles ["toolbar", "osd", "tag-bar"]

            Gtk.Box preview_tags {
              spacing: 6;
            }

            Gtk.Entry preview_tag_entry {
              placeholder-text: _("Add Tag…");
              width-chars: 14;

              accessibility {
                label: _("Add Tag");
              }
            }
          }

          // On the side of the window's own close button (src/window.rs `place_close`).
          [overlay]
          Gtk.Button preview_close {
            icon-name: "window-close-symbolic";
            tooltip-text: _("Close Preview (Esc)");
            action-name: "win.close-preview";
            valign: start;
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            styles ["osd", "circular"]
          }
        }
      };
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split.collapsed: true;
    }
  }
}

menu view_menu {
  section {
    item {
      custom: "size";
    }
  }
}

menu main_menu {
  section {
    item (_("Use Folder Names as Tags…"), "win.tags-from-folders")
  }

  section {
    item (_("About Memeplex"), "app.about")
    item (_("Quit"), "app.quit")
  }
}
