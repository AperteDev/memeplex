using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Memeplex";
  default-width: 1100;
  default-height: 750;

  content: Adw.NavigationSplitView split {
    min-sidebar-width: 220;
    max-sidebar-width: 320;

    // The meme folder and the folders in it, as Notav's tree (src/window.rs `refresh_tree`).
    sidebar: Adw.NavigationPage {
      title: "Memeplex";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [start]
          Gtk.Button {
            icon-name: "folder-open-symbolic";
            tooltip-text: _("Open Folder… (Ctrl+O)");
            action-name: "win.open";
          }

          [end]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: main_menu;
            tooltip-text: _("Main Menu");
            primary: true;
          }
        }

        content: Gtk.ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Gtk.ListBox tree {
            styles ["navigation-sidebar"]
          }
        };
      };
    };

    // The memes of the folder picked in the tree (src/window.rs `show_folder`).
    content: Adw.NavigationPage content_page {
      title: "Memeplex";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [end]
          Gtk.MenuButton {
            icon-name: "view-grid-symbolic";
            tooltip-text: _("View Options");

            // The builder sets the menu after the children: the size row is added to it in
            // code (`size_box`).
            popover: Gtk.PopoverMenu view_popover {
              menu-model: view_menu;

              [size]
              Gtk.Box size_box {
                spacing: 6;
                margin-start: 6;
                margin-end: 6;

                Gtk.Image {
                  icon-name: "zoom-out-symbolic";
                }

                // A thumbnail's side in pixels (src/window.rs `connect_size`).
                Gtk.Scale size {
                  hexpand: true;
                  width-request: 180;
                  draw-value: false;
                  tooltip-text: _("Thumbnail Size");

                  adjustment: Gtk.Adjustment {
                    lower: 80;
                    upper: 400;
                    value: 180;
                    step-increment: 20;
                    page-increment: 40;
                  };

                  accessibility {
                    label: _("Thumbnail Size");
                  }
                }

                Gtk.Image {
                  icon-name: "zoom-in-symbolic";
                }
              }
            };
          }
        }

        content: Gtk.Stack stack {
          Gtk.StackPage {
            name: "welcome";

            child: Adw.StatusPage {
              icon-name: "dev.aperte.Memeplex";
              title: "Memeplex";
              description: _("Open a folder with your memes to start");

              Gtk.Button {
                label: _("Open Folder…");
                action-name: "win.open";
                halign: center;
                styles ["suggested-action", "pill"]
              }
            };
          }

          Gtk.StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "folder-pictures-symbolic";
              title: _("No Memes");
              description: _("This folder has no pictures or videos");
            };
          }

          Gtk.StackPage {
            name: "grid";

            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;

              Gtk.GridView grid {
                max-columns: 30;
                styles ["memes"]
              }
            };
          }
        };
      };
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split.collapsed: true;
    }
  }
}

menu view_menu {
  section {
    item {
      custom: "size";
    }
  }
}

menu main_menu {
  item (_("Open Folder…"), "win.open")
  item (_("About Memeplex"), "app.about")
  item (_("Quit"), "app.quit")
}
